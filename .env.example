# Copy these into the environment T3 Code runs in. Keys are read from the
# environment by OpenCode (env list in each provider entry); they are never
# stored in opencode.jsonc and never committed here.
#
# Windows: setx OPENROUTER_API_KEY "..."
# macOS/Linux: export OPENROUTER_API_KEY="..." in your shell profile

OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
